BossKilledMessage: Killing this enemy has released its power upon the world

Configs: {
	Config: {
		DisplayName: ARPG Enemy System Config

		LevelCapIncreasePerBossDowned: {
			Tooltip: ""
			Label: Level Cap Increase Per Boss Downed
		}

		Headers: {
			Scaling: Scaling Config
			Elemental: Elemental Config
		}

		ScalingExponent: {
			Label: Scaling Exponent
			Tooltip: Exponent applied to enemy level in the HP/damage scaling formula: 1 + level^exponent × phaseRate. Higher values = steeper growth curve.
		}

		DefScalingExponent: {
			Label: Defense Scaling Exponent
			Tooltip: Exponent for the defense scaling curve. Higher than ScalingExponent keeps physRes meaningful at high levels.
		}

		DefenseFloor: {
			Label: Defense Floor
			Tooltip: Additive defense added per level (level × floor). Ensures low-defense enemies like slimes have non-trivial physRes.
		}

		ElementalResistanceCap: {
			Label: Elemental Resistance Cap
			Tooltip: Maximum elemental resistance % any enemy or player can have after clamping.
		}

		PlayerPhysResCap: {
			Label: Player Phys Res Cap
			Tooltip: Maximum physical resistance % a player can reach. Default 80.
		}

		PhysResHalfPoint: {
			Label: Phys Res Half Point
			Tooltip: Defense value at which physRes reaches cap/2. Controls curve steepness. Default 30.
		}
	}

	ConfigClient: {
		DisplayName: Config Client

		EnableEnemyStatPanel: {
			Label: Enable Enemy Stat Panel
			Tooltip: Enable or Disable Enemy Stat Panel
		}

		EnableElementalDamageLog: {
			Label: Enable Elemental Damage Log
			Tooltip: ""
		}
	}
}

NPCTooltip: {
	HeaderNormal: Level {0}  {1}  [{2}]
	HeaderNormalNoMods: Level {0}  {1}
	HeaderBoss: Level {0}
	StatsLine: Damage: {0}   Defense: {1} (Phys Res {2}%)
	Resistances: Resistances: Fire {0}%  Cold {1}%  Lightning {2}%
	ElemDmgLabel: Elem Dmg:
	PenLabel: Penetration:
	ElemDmgNone: Elem Dmg: none
	Fire: Fire {0}%
	Cold: Cold {0}%
	Lightning: Lightning {0}%
	FirePen: Fire {0}
	ColdPen: Cold {0}
	LightningPen: Lightning {0}
	Sundering: Sundering {0}
}
