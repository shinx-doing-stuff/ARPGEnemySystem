BossKilledMessage: Killing this enemy has released its power upon the world

BossScaling: {
	Expert: "{0}: {1} player(s), solo life {2}, after player scaling {3}, final life {4} (level {5})"
	Normal: "{0}: Normal mode, no player scaling, final life {1} (level {2})"
}

Configs: {
	Config: {
		DisplayName: ARPG Enemy System Config

		Headers: {
			Scaling: Scaling Config
			Elemental: Elemental Config
			Debug: Debug
		}

		ScalingExponent: {
			Label: Scaling Exponent
			Tooltip: Exponent applied to enemy level in the HP, defense and damage curve. Each progression phase adds its own slope on level^exponent from its start level, with no jump at a phase change. Higher values = steeper growth.
		}

		ArmourHalving: {
			Label: Armour Halving
			Tooltip: Defense points that halve the damage landing: an enemy with this much defense, after the attacker's armour penetration, takes half. The four elemental resistances derive from a share of defense through the same curve. Default 80.
		}

		PhysResHalfPoint: {
			Label: Phys Res Half Point
			Tooltip: The player's half point: defense at which the player's physical resistance reaches half its cap. Default 60.
		}

		EnableBossScalingLog: {
			Label: Enable Boss Scaling Log
			Tooltip: Chat line when a boss spawns: player count, solo life, life after player scaling, final life and level.
		}
	}

	ConfigClient: {
		DisplayName: Config Client

		EnableEnemyStatPanel: {
			Label: Enable Enemy Stat Panel
			Tooltip: Enable or Disable Enemy Stat Panel
		}

		EnableElementalDamageLog: {
			Label: Enable Elemental Damage Log
			Tooltip: ""
		}

		EnableReapLog: {
			Label: Enable Reap Log
			Tooltip: Chat breakdown of every reap: gate, stacks, multiplier, element and final damage.
		}
	}
}

NPCTooltip: {
	HeaderNormal: Level {0}  {1}  [{2}]
	HeaderNormalNoMods: Level {0}  {1}
	HeaderBoss: Level {0}
	StatsLine: Damage: {0}   Defense: {1} (Phys Res {2}%)
	Resistances: Resistances: Fire {0}%  Cold {1}%  Lightning {2}%  Chaos {3}%
	ElemDmgLabel: Elem Dmg:
	PenLabel: Penetration:
	ElemDmgNone: Elem Dmg: none
	Fire: Fire {0}%
	Cold: Cold {0}%
	Lightning: Lightning {0}%
	Chaos: Chaos {0}%
	FirePen: Fire {0}
	ColdPen: Cold {0}
	LightningPen: Lightning {0}
	Sundering: Sundering {0}
	ChaosPen: Chaos {0}
}
